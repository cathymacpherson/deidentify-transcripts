# Ollama runs locally and exposes this OpenAI-compatible endpoint.
OLLAMA_BASE_URL=http://localhost:11434/v1

# Download with: ollama pull qwen3:8b
OLLAMA_MODEL=qwen3:8b

# Ollama requires a non-empty API key field but ignores its value.
OLLAMA_API_KEY=ollama

# Stage-one model detections below this confidence are sent for human review.
DEID_LOW_CONFIDENCE_THRESHOLD=0.5

# Per-request timeout. CPU-only laptops can be slow on the first request.
DEID_REQUEST_TIMEOUT_SECONDS=180

